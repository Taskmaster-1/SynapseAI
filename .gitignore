# Root-level .gitignore for SynapseAI monorepo

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Environment files
.env
.env.*
!**/.env.example
!**/.env.local.example

# Node / Next.js
node_modules/
.next/
/out/
/build
.pnp
.pnp.js

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
/coverage

# Type checking
.mypy_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Misc
.composio.lock
.ruff_cache/
*.tsbuildinfo
next-env.d.ts
.vercel
