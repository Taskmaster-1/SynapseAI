{
  "name": "synapse",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "bun run --filter '@synapse/server' dev & bun run --filter '@synapse/web' dev",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --filter '@synapse/web' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun run --filter '@synapse/db' generate",
    "evals": "bun run packages/evals/src/cli.ts",
    "seed": "bun run --filter '@synapse/server' seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "6.0.3"
  }
}
