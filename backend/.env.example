# ══════════════════════════════════════════════════════════════════════════════
#  .env.example — copy to .env and fill in values
#  Never commit .env to version control
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="My SaaS App"
APP_VERSION="1.0.0"
ENV=development                          # development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Keep this secret — server only!
SUPABASE_STORAGE_BUCKET=uploads

# ── AI Providers ──────────────────────────────────────────────────────────────
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Groq (fallback): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Tavily Search: https://tavily.com → Get API Key (free tier: 1,000 searches/month)
TAVILY_API_KEY=tvly-your-api-key-here
TAVILY_MAX_RESULTS=5

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...         # from: stripe listen --forward-to localhost:8000/api/v1/payments/webhook
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# ── Email (Resend / SMTP) ─────────────────────────────────────────────────────
# Resend: https://resend.com/api-keys
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_...
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="My SaaS App"

# ── Storage ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Composio ──────────────────────────────────────────────────────────────────
# Get API key: https://app.composio.dev/settings
COMPOSIO_API_KEY=your-composio-api-key

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=8
AGENT_WINDOW_SIZE=20
AGENT_SUMMARIZE_THRESHOLD=40

# ── Redis (optional but recommended) ─────────────────────────────────────────
# Without Redis, token denylist is disabled (logout doesn't revoke tokens immediately)
# Local:      redis://localhost:6379/0
# Docker:     redis://redis:6379/0
# Railway:    set from Railway Redis plugin
REDIS_URL=redis://localhost:6379/0

# ── App URLs (for OAuth callbacks) ───────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Scheduler ─────────────────────────────────────────────────────────────────
# No keys needed — scheduler runs in-process using APScheduler
# Daily digest uses SMTP settings above

# ── Railway / Render deploy ───────────────────────────────────────────────────
# Railway: set RAILWAY_TOKEN in GitHub Actions secrets
# Render:  copy deploy/render.yaml to project root
