# ── Core ─────────────────────────────────────────────────────────────────────
# postgres://user:pass@host:5432/db (needs pgvector), or pglite://<dir> for an
# embedded single-process database (default: pglite://.data/pglite).
DATABASE_URL=
# Encrypts OAuth tokens and provider keys, signs sessions. 32+ random chars.
# Generate: openssl rand -base64 32   (required in production)
SYNAPSE_SECRET=
# The URL people open (the web app; it proxies /api to the server).
PUBLIC_URL=http://localhost:3000
# all | api | worker — run API and workers together or separately.
ROLE=all
WORKER_CONCURRENCY=4
ALLOW_SIGNUP=true

# ── Models (users can also bring their own keys in Settings) ─────────────────
# Ordered fallback chain of provider:model. Providers: anthropic, openai, google, openai-compatible.
SYNAPSE_MODELS=anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5
SYNAPSE_SUMMARY_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Any OpenAI-compatible endpoint (vLLM, Ollama, LiteLLM), used as openai-compatible:<model>
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── Optional features ────────────────────────────────────────────────────────
# tavily | brave | exa
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
# openai:text-embedding-3-small or google:gemini-embedding-001 (uses that provider's key).
# Unset = knowledge search uses full-text only.
EMBEDDING_MODEL=

# ── Limits ───────────────────────────────────────────────────────────────────
RUN_MAX_STEPS=25
RUN_MAX_COST_USD=2
DAY_MAX_COST_USD=20

# ── Social login (optional) ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allow MCP servers / web_fetch on private networks (self-hosted MCP on your LAN).
SYNAPSE_ALLOW_PRIVATE_NETWORK=false
