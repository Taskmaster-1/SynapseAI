# ── Core ─────────────────────────────────────────────────────────────────────
# postgres://user:pass@host:5432/db (needs pgvector), or pglite://<dir> for an
# embedded single-process database (default: pglite://.data/pglite).
DATABASE_URL=
# Encrypts OAuth tokens and provider keys, signs sessions. 32+ random chars.
# Generate: openssl rand -base64 32   (required in production)
SYNAPSE_SECRET=
# The URL people open (the web app; it proxies /api to the server).
PUBLIC_URL=http://localhost:3000
# all | api | worker — run API and workers together or separately.
ROLE=all
WORKER_CONCURRENCY=4
ALLOW_SIGNUP=true

# ── Models (users can also bring their own keys in Settings) ─────────────────
# Ordered fallback chain of provider:model. Providers: anthropic, openai, google, gateway,
# openai-compatible. Unset: Claude Opus then Sonnet, through the gateway if AI_GATEWAY_API_KEY is
# the only Anthropic route configured.
# SYNAPSE_MODELS=anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5
# SYNAPSE_SUMMARY_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
# Vercel AI Gateway: one key for every provider, used as gateway:<creator>/<model>,
# e.g. gateway:anthropic/claude-sonnet-5.5.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Any OpenAI-compatible endpoint (vLLM, Ollama, LiteLLM), used as openai-compatible:<model>
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Model list prices sync daily from the gateway's public catalog (no key is sent). Set false
# to stay offline; built-in prices for current Claude, GPT and Gemini models are used then.
SYNAPSE_PRICE_SYNC=true

# ── Optional features ────────────────────────────────────────────────────────
# tavily | brave | exa
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
# openai:text-embedding-3-small or google:gemini-embedding-001 (uses that provider's key).
# Unset = knowledge search uses full-text only.
EMBEDDING_MODEL=

# ── Limits ───────────────────────────────────────────────────────────────────
RUN_MAX_STEPS=25
RUN_MAX_COST_USD=2
DAY_MAX_COST_USD=20

# ── Social login (optional) ──────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Google (optional) ────────────────────────────────────────────────────────
# One OAuth app powers "Sign in with Google" and the built-in Gmail + Calendar
# integration (and email triggers). Setup: docs/google.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# How often email triggers check for new mail, in seconds (min 30).
# TRIGGER_POLL_SECONDS=120

# ── Slack (optional) ─────────────────────────────────────────────────────────
# Approve and deny from Slack DMs. All three from your Slack app's Basic Information page;
# PUBLIC_URL must be public https for Slack to reach it. Setup: docs/slack.md
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Built-in Linear tools (search, read, file and update issues, comment). From a Linear
# OAuth app (Settings → API → OAuth applications). Setup: docs/linear.md
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# ── Notifications (optional) ─────────────────────────────────────────────────
# Web Push for approvals on phones and desktops. Setup: docs/notifications.md
# Generate a pair: bunx web-push generate-vapid-keys
# Unset in development: a pair is generated once into .data/vapid.json. Production: off until set.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com (or an https URL). Required in production.
# VAPID_SUBJECT=mailto:you@example.com
# Email alerts (each user opts in under Settings → Notifications).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=Synapse <synapse@example.com>
# Web app: register the service worker under `next dev` too (it always is in production builds).
# NEXT_PUBLIC_ENABLE_SW=true

# Allow MCP servers / web_fetch on private networks (self-hosted MCP on your LAN).
SYNAPSE_ALLOW_PRIVATE_NETWORK=false
